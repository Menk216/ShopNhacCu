<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập Quản Trị Hệ Thống - Melody Store Admin</title>
    <link rel="stylesheet" href="/static/css/admin.css">
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 50%, #f8fafc 100%);
            color: #1e293b;
        }
        .admin-login-box {
            background: #ffffff;
            border-radius: 16px;
            padding: 2.75rem 2.5rem;
            width: 100%;
            max-width: 440px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        }
        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-header h2 {
            font-size: 1.45rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
        }
        .login-header p {
            color: #64748b;
            font-size: 0.88rem;
            margin-top: 0.35rem;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            margin-bottom: 1.25rem;
        }
        .form-group label {
            font-size: 0.82rem;
            font-weight: 700;
            color: #334155;
        }
        .form-control {
            padding: 0.7rem 0.9rem;
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            border-radius: 8px;
            font-size: 0.92rem;
            outline: none;
            transition: all 0.2s;
        }
        .form-control:focus {
            border-color: #d97706;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.15);
        }
        .btn-admin-submit {
            width: 100%;
            background: #d97706;
            color: #fff;
            padding: 0.8rem;
            border-radius: 8px;
            border: none;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 6px -1px rgba(217, 119, 6, 0.2);
        }
        .btn-admin-submit:hover {
            background: #b45309;
            transform: translateY(-1px);
            box-shadow: 0 6px 10px -1px rgba(217, 119, 6, 0.3);
        }
    </style>
</head>
<body>

    <div class="admin-login-box">
        <div class="login-header">
            <h2>QUẢN TRỊ HỆ THỐNG</h2>
            <p>Trang đăng nhập dành riêng cho Quản lý & Chủ cửa hàng</p>
        </div>

        <form id="adminLoginForm">
            <div class="form-group">
                <label for="adminUsername">Tên đăng nhập Quản trị</label>
                <input type="text" id="adminUsername" class="form-control" placeholder="Tài khoản quản trị" required autofocus>
            </div>

            <div class="form-group">
                <label for="adminPassword">Mật khẩu</label>
                <input type="password" id="adminPassword" class="form-control" placeholder="Mật khẩu" required>
            </div>

            <button type="submit" class="btn-admin-submit">Đăng Nhập Quản Trị</button>

            <div style="margin-top: 1.5rem; font-size: 0.82rem; color: #475569; background: #f8fafc; padding: 0.75rem; border-radius: 8px; text-align: center; border: 1px dashed #cbd5e1;">
                Tài khoản mặc định: <strong style="color: #0f172a;">admin</strong> / Mật khẩu: <strong style="color: #0f172a;">admin123</strong>
            </div>

            <div style="margin-top: 1.25rem; text-align: center;">
                <a href="/" style="font-size: 0.85rem; color: #64748b; text-decoration: none; font-weight: 600;" onmouseover="this.style.color='#d97706'" onmouseout="this.style.color='#64748b'">&larr; Quay lại trang bán hàng khách</a>
            </div>
        </form>
    </div>

    <script src="/static/js/api.js"></script>
    <script>
        document.getElementById('adminLoginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = document.getElementById('adminUsername').value.trim();
            const password = document.getElementById('adminPassword').value.trim();

            try {
                const res = await fetchAPI('/api/admin/login', {
                    method: 'POST',
                    body: JSON.stringify({ username, password })
                });
                showToast('Đăng nhập thành công! Đang vào trang quản trị...', 'success');
                setTimeout(() => {
                    window.location.href = '/admin/dashboard';
                }, 600);
            } catch (err) {
                showToast(err.message, 'error');
            }
        });
    </script>
</body>
</html>
