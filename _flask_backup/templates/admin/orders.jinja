{% extends 'admin/base_admin.html' %}

{% block title %}Quản Lý Đơn Đặt Hàng - Melody Store Admin{% endblock %}
{% block page_title %}Quản Lý Đơn Đặt Hàng Của Khách Hàng{% endblock %}

{% block content %}
<!-- Search & Filter Bar by Date range & Status -->
<div class="toolbar-card">
    <div class="filter-group">
        <div class="form-group">
            <label for="filterOrderStatus">Tình trạng đơn hàng</label>
            <select id="filterOrderStatus" class="form-control" onchange="loadAdminOrders()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="pending">Mới đặt</option>
                <option value="processing">Đã xử lý</option>
                <option value="delivered">Đã giao</option>
                <option value="cancelled">Hủy</option>
            </select>
        </div>
        <div class="form-group">
            <label for="filterOrderFromDate">Từ ngày đặt</label>
            <input type="date" id="filterOrderFromDate" class="form-control" onchange="loadAdminOrders()">
        </div>
        <div class="form-group">
            <label for="filterOrderToDate">Đến ngày đặt</label>
            <input type="date" id="filterOrderToDate" class="form-control" onchange="loadAdminOrders()">
        </div>
        <div class="form-group" style="min-width: 220px;">
            <label for="filterOrderSearch">Tìm mã ĐH / Tên khách</label>
            <input type="text" id="filterOrderSearch" class="form-control" placeholder="DH-..., tên người nhận..." oninput="loadAdminOrders()">
        </div>
    </div>
    <div>
        <button class="btn btn-secondary" onclick="loadAdminOrders()">↺ Làm mới</button>
    </div>
</div>

<!-- Orders Table -->
<div class="table-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Mã đơn hàng</th>
                <th>Ngày đặt</th>
                <th>Người nhận</th>
                <th>Số lượng món</th>
                <th>Tổng thanh toán</th>
                <th>Tình trạng</th>
                <th>Thanh toán</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody id="ordersTableBody">
            <!-- Rendered by static/js/admin.js -->
        </tbody>
    </table>
</div>

<!-- Order Detail & Status Update Modal -->
<div id="orderDetailModal" class="admin-modal-overlay">
    <div class="admin-modal" style="max-width: 720px;">
        <div class="admin-modal-header">
            <h3 style="font-size: 1.15rem; font-weight: 700;">Chi Tiết Đơn Hàng #<span id="modalOrderCodeDisplay"></span></h3>
            <button class="modal-close" onclick="closeAdminModal('orderDetailModal')">&times;</button>
        </div>

        <div id="orderDetailContent">
            <!-- Loaded via JS -->
        </div>

        <!-- Status update form -->
        <form onsubmit="submitUpdateOrderStatus(event)" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; margin-top: 1.25rem;">
            <input type="hidden" id="modalOrderId">
            <h4 style="font-size: 0.95rem; font-weight: 700; color: #0f172a; margin-bottom: 0.75rem;">Cập Nhật Trạng Thái Đơn Hàng:</h4>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div class="form-group">
                    <label for="modalOrderStatusSelect">Tình trạng đơn hàng (*)</label>
                    <select id="modalOrderStatusSelect" class="form-control" required>
                        <option value="pending">Mới đặt</option>
                        <option value="processing">Đã xử lý</option>
                        <option value="delivered">Đã giao</option>
                        <option value="cancelled">Hủy (Tự động hoàn tồn kho)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="modalPaymentStatusSelect">Tình trạng thanh toán</label>
                    <select id="modalPaymentStatusSelect" class="form-control">
                        <option value="unpaid">Chưa thanh toán</option>
                        <option value="paid">Đã thanh toán</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeAdminModal('orderDetailModal')">Đóng</button>
                <button type="submit" class="btn btn-primary">Lưu Trạng Thái Đơn</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('search')) {
            const searchInput = document.getElementById('filterOrderSearch');
            if (searchInput) searchInput.value = urlParams.get('search');
        }
        loadAdminOrders();
    });
</script>
{% endblock %}
